# ~/.bashrc is read by interactive non-login bash (a new terminal on Linux),
# by bash running a command over SSH (`ssh host <command>`), by bash logins
# via ~/.profile, and on some systems directly by /etc/profile.
# It must run on bash 3.2 (macOS) and later.

# Flag for ~/.profile to avoid reading this file twice
DOT_BASHRC_SOURCED=1

# PATH and Homebrew come from ~/.profile, unless a login shell has read it already
if [ "${DOT_PROFILE_SOURCED:-}" != 1 ] && [ -r "$HOME/.profile" ]; then
  . "$HOME/.profile"
fi

# Nothing more for non-interactive shells: scp, rsync, git and etterminal
# talk over SSH commands, so nothing may print or prompt
case $- in
  *i*) ;;
  *) return ;;
esac


HISTCONTROL=ignoreboth
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize

# Completion, from the distro or Homebrew
for FILE in /usr/share/bash-completion/bash_completion /etc/bash_completion \
  "${HOMEBREW_PREFIX:-/nonexistent}/etc/profile.d/bash_completion.sh"; do
  if [ -r "$FILE" ]; then
    . "$FILE"
    break
  fi
done
unset FILE

# Optional tools, each only if installed
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"
# Don't send usage data to Eternal Terminal's developers (the client's default)
command -v et >/dev/null 2>&1 && alias et='et --telemetry=false'
# `fzf --bash` needs fzf 0.48 or later; older versions print nothing useful
command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash 2>/dev/null)"
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza --group-directories-first --long --git'
  alias la='eza --group-directories-first --long --git --all'
fi
# Debian's fd-find package installs the command as fdfind
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
  alias fd=fdfind
fi
if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never --style=plain'
elif command -v batcat >/dev/null 2>&1; then
  alias bat=batcat
  alias cat='batcat --paging=never --style=plain'
fi

# Machine-specific setup that doesn't belong in the dotfiles repo, such as
# `exec zsh -l` where the login shell can't be changed
if [ -r "$HOME/.bashrc.local" ]; then
  . "$HOME/.bashrc.local"
fi
