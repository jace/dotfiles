#!/bin/sh
# Reload tmux.conf into a running tmux server after chezmoi changes it: tmux
# only reads its config when the server starts.
# tmux.conf hash: {{ include "private_dot_config/tmux/tmux.conf" | sha256sum }}
command -v tmux >/dev/null 2>&1 || exit 0
tmux has-session 2>/dev/null || exit 0
tmux source-file "$HOME/.config/tmux/tmux.conf" && echo "Reloaded tmux.conf into the running tmux server"
